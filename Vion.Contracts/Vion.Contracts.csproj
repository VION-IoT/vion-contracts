<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>false</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPublishable>false</IsPublishable>
        <IsPackable>true</IsPackable>
        <PackageId>Vion.Contracts</PackageId>
        <Description>Shared contracts (MQTT topics, payloads, FlatBuffers schemas, introspection models) used by the Vion Dale SDK and runtime.</Description>
        <!-- PackageReadmeFile and the shared docs/package-readme.md are wired via Directory.Build.targets -->
    </PropertyGroup>

    <ItemGroup>
        <!--shim to be able to use readonly record structs in netstandard2.1-->
        <PackageReference Include="Google.FlatBuffers" Version="25.2.10"/>
        <PackageReference Include="IsExternalInit" Version="1.0.3">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0"/>
        <!--shim to be able to use required members in netstandard2.1-->
        <PackageReference Include="RequiredMemberAttribute" Version="1.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- ImmutableArray<T> is not in netstandard2.1's box; explicit pin required. -->
        <PackageReference Include="System.Collections.Immutable" Version="10.0.7"/>
        <!-- JsonNode/JsonObject are not in netstandard2.1's box; explicit pin required. -->
        <PackageReference Include="System.Text.Json" Version="10.0.7"/>
    </ItemGroup>

</Project>