include "modbus_function_code.fbs";

namespace Vion.Contracts.FlatBuffers.Hw.Modbus;

table SetModbusPayload {
    function_code:ModbusFunctionCode;
    unit_identifier:ubyte;
    address:ushort; // For single coil/register, this is the address. For multiple coils/registers, this is the starting address.
    data:[ubyte];
}

root_type SetModbusPayload;