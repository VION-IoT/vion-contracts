namespace Vion.Contracts.FlatBuffers.Common;

enum CommonValueKind : byte { None = 0, Int = 1, Double = 2, Bool = 3, String = 4, DateTime = 5, TimeSpan = 6 }

table CommonValue {
  kind: CommonValueKind;
  int_value:int;
  double_value:double;
  bool_value:bool;
  string_value:string;
  datetime_unix_ms:long;
  timespan_ticks:long;
}
